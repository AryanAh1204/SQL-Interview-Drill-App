# AI style feedback (optional). Without it, questions + grading work fully offline.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Aptitude tab (required for that tab only — the SQL drill works without it).
# Questions are generated live, so this key is needed at runtime, not just at
# build time. Free key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_key_here

# Optional: override the NIM model. NVIDIA retires model ids periodically —
# run `python aptitude.py --list-models` to see what your key can call.
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Persistent accounts + history (optional). When unset, the app uses a local
# SQLite file (drill_history.db). Set this to a Postgres URL (e.g. Neon) for
# durable storage. Format: postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL=
