# Copy this file to .streamlit/secrets.toml for local Postgres dev,
# OR paste each key into the Streamlit Community Cloud "Secrets" dashboard.
#
# Get a free DATABASE_URL from https://neon.tech  (free tier, 0.5 GB Postgres)
# Connection string format:  postgresql://user:pass@host/dbname?sslmode=require

DATABASE_URL = "postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ANTHROPIC_API_KEY is only needed if you use the AI hint / grading feature.
ANTHROPIC_API_KEY = "sk-ant-..."
